# ==============================================================================
# SMK YPK MEDAN SUPER APP - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal atau atur di dashboard Vercel / hosting Anda.

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# URL project Supabase Anda (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://wpyfwkcevgdhkazeesdq.supabase.co

# Supabase Anon Key (Public) - Digunakan di client-side untuk membaca data publik
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (SECRET / PRIVATE) - WAJIB DIISI!
# Digunakan HANYA di server-side Next.js (/api/*) untuk grading CBT, registrasi device,
# penugasan inval, dan update manual yang membutuhkan bypass Row Level Security (RLS).
# JANGAN PERNAH menyebarkan key ini ke client atau repository publik!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secret pepper untuk hashing password dengan PBKDF2 (ubah dengan string acak rahasia)
AUTH_SECRET_PEPPER=smk_ypk_medan_secure_salt_pepper_2026_super_app

# Secret key untuk HMAC-SHA256 penandatanganan Session Token / Cookie JWT
AUTH_TOKEN_SECRET=smk_ypk_session_token_hmac_secret_key_medan_v2

# ------------------------------------------------------------------------------
# 3. APPLICATION URL
# ------------------------------------------------------------------------------
# URL aplikasi untuk pembuatan tautan PDF dan cetak resmi
NEXT_PUBLIC_APP_URL=http://localhost:3000
